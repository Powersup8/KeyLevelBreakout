// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © mabvvy61
// TSLA Open Scalper
// 0DTE/1DTE opening trade decision system (v2.1)
// v2.1: CRASH/SURGE direction override + immediate entry, SURGE pat_max_hold=20
// v2.0a: skip on agree=0/2 (3/20 fix), ORB label spacing
// v2.0: VWAP+EMA20 agreement sizing, 1m-bar trail exit, smart entry (confirm/bounce)
// v1.4b: S/M/L sizing, gap<-5 kill, PUT rescue, dual direction
// v1.4: dual direction — CALLS on MED/HIGH, PUTS on LOW/NO-GO
// v1.3b: vol kill 7000→3000, runner label only if conf>=4
// v1.2c: fix SL self-trigger on ORB freeze bar, fakeout = bar2 must break bar1 low
// v1.2: 2m accel, 15s/30s sub-bars, ORB-based SL, min ORB width
// Designed for TSLA on 1-min chart with Extended Hours ON
//@version=6
indicator("TSLA Open Scalper v2.1", overlay=true, max_labels_count=50, max_lines_count=20)

// ─── Inputs ────────────────────────────────────────────────
i_vixSymbol    = input.string("CBOE:VIX", "VIX Symbol", tooltip="VIX data provider. Try TVC:VIX if CBOE:VIX fails.", group="Data")
i_exitMethod   = input.string("Trail", "Exit Method", options=["Trail", "Fixed 1m", "Fixed 2m", "Fixed 3m"], tooltip="Trail: 1m-bar trail stop from peak. Fixed: exit at N minutes after entry.", group="Trade")
i_trailAmt     = input.float(0.80, "Trail Amount ($)", minval=0.25, maxval=3.0, step=0.05, tooltip="For Trail exit: exit when PnL drops this much from peak on 1m bar close. Research: $0.80 optimal.", group="Trade")
i_maxHold      = input.int(7, "Max Hold (minutes)", minval=1, maxval=15, tooltip="Maximum hold time before forced exit. Research: 7m optimal for trail.", group="Trade")
i_smartEntry   = input.bool(true, "Smart Entry", tooltip="If going right: wait for bar1 confirmation. If going wrong: wait for 15% bounce. Else enter at open.", group="Trade")
i_bounceRecov  = input.float(15.0, "Bounce Recovery (%)", minval=5.0, maxval=50.0, step=5.0, tooltip="On dip days: enter when price bounces X% of the dip. Research: 15-20% optimal.", group="Trade")
i_minOrbWidth  = input.float(1.0, "Min ORB Width ($)", minval=0.25, step=0.25, tooltip="Skip breakout if ORB range < this (noise filter). Research: P25=$3.70, too narrow = false breakouts.", group="Trade")
i_pmVolMinKill = input.float(3000, "PM Vol Min Kill", minval=0, step=1000, tooltip="Hard kill if PM volume (9:25-9:29) < this. Set 0 to disable. Research: 3000 catches dead days (Sharpe 3.20), 7000 killed 20 winners.", group="Trade")
i_showTable    = input.bool(true, "Show Info Table", group="Visuals")
i_showBG       = input.bool(true, "Show Background Colors", group="Visuals")
i_debugLog     = input.bool(false, "Log Signals (Pine Logs)", group="Debug")

// ─── External Data ─────────────────────────────────────────
vix_prev_close = request.security(i_vixSymbol, "D", close[1], lookahead=barmerge.lookahead_on)
spy_close      = request.security("SPY", "1", close)
qqq_close      = request.security("QQQ", "1", close)

// 15s sub-bars for P9 hard kill (last 30s of 9:29 bar)
sub15_close    = request.security_lower_tf(syminfo.tickerid, "15S", close)

// 30s sub-bars for fakeout detection (real A6 patterns)
sub30_open     = request.security_lower_tf(syminfo.tickerid, "30S", open)
sub30_high     = request.security_lower_tf(syminfo.tickerid, "30S", high)
sub30_low      = request.security_lower_tf(syminfo.tickerid, "30S", low)
sub30_close    = request.security_lower_tf(syminfo.tickerid, "30S", close)

// ─── Debug Helpers ─────────────────────────────────────────
fmtTime(int t) =>
    int _h = hour(t, "America/New_York")
    int _m = minute(t, "America/New_York")
    str.tostring(_h) + ":" + (_m < 10 ? "0" : "") + str.tostring(_m)

logMsg(string msg) =>
    if i_debugLog and barstate.isconfirmed
        log.info("[SCALP] " + syminfo.ticker + " " + fmtTime(time) + " " + msg)

// ─── Label Spacing ───────────────────────────────────────────
// TSLA ~$400: use fixed offset to prevent label overlap
float labelOff = 1.5  // $1.50 vertical offset between stacked labels

// ─── Timezone & Session Detection ──────────────────────────
TZ = "America/New_York"

int h  = hour(time, TZ)
int m  = minute(time, TZ)
int hm = h * 100 + m

isPremarket    = hm >= 400 and hm <= 929
isRTH          = hm >= 930 and hm <= 1559
newSession     = isPremarket and not isPremarket[1]
is0920         = h == 9 and m == 20
is0925         = h == 9 and m == 25
is0927         = h == 9 and m == 27
is0929         = h == 9 and m == 29
is0930         = h == 9 and m == 30
is0934         = h == 9 and m == 34
is0935         = h == 9 and m == 35
isORBBuild     = hm >= 931 and hm <= 933
isActiveWindow = hm >= 920 and hm <= 955

// ─── Extended Hours Guard ──────────────────────────────────
var bool pmSeen = false
if isPremarket
    pmSeen := true
if newSession
    pmSeen := false

// ─── State Machine ─────────────────────────────────────────
// v2.0: 0=SLEEP, 1=PRE_SCAN, 2=OPENING, 3=ENTRY_WATCH, 4=ACTIVE, 5=DONE
var int    state         = 0
var int    confidence    = 0
var string tier          = "—"
var bool   hard_kill     = false
var bool   fakeout_fired = false
var bool   shakeout_detected = false

// Premarket tracking
var float pm_high       = na
var float pm_low        = na
var float pm_position   = na
var float pm_accel      = na
var float pm_late_trend = na
var float close_929     = na
var float open_929      = na    // for P9 30s proxy (9:29 bar direction)
var float open_927      = na    // for 2m accel (9:27→9:29)
var float open_925      = na    // kept for PM volume window
var float open_920_tsla = na
var float pm_vol_5m     = 0.0   // PM volume 9:25-9:29

// Cross-symbol PM
var float spy_920       = na
var float qqq_920       = na
var float spy_929       = na
var float qqq_929       = na

// Session / entry
var float prev_day_close = na
var float gap            = na
var float open_930       = na   // may be adjusted on smart entry
var float orig_open_930  = na   // always the raw 9:30 open
var float close_935      = na
var bool  is_hold        = false
var bool  is_call_tier   = false  // v2.0: persisted direction from pre-scan

// ORB tracking
var float orb_high       = na
var float orb_low        = na
var bool  orb_bull       = false   // bull breakout detected
var bool  orb_bear       = false   // bear breakout detected
var int   bar_930_idx    = na      // bar_index at 9:30
var bool  orb_narrow     = false   // v1.2: ORB too narrow to trade

// Visual object IDs
var line  entryLine      = na
var line  orbHighLine    = na
var line  orbLowLine     = na

// v2.0: Agreement sizing
var float pm_vwap       = na    // PM VWAP from 9:20-9:29
var float pm_ema5       = na    // EMA(5) of 1m PM closes
var bool  vwap_agrees   = false // VWAP direction agrees with binary conf
var bool  ema_agrees    = false // EMA direction agrees with binary conf
var bool  triple_agree  = false // all 3 agree → L size
var int   agree_count   = 0     // 0-2 (VWAP + EMA agreement count)
var float pm_vwap_cv    = 0.0   // cumulative close*volume for VWAP
var float pm_vwap_v     = 0.0   // cumulative volume for VWAP

// v2.0: Trail exit tracking
var float trade_entry   = na    // actual entry price (may differ from open on smart entry)
var float peak_pnl      = 0.0   // running max PnL since entry
var int   entry_bar_idx = na    // bar_index at entry
var bool  trade_active  = false // currently in a trade
var bool  trail_exited  = false // trail stop was hit

// v2.0: Smart entry tracking
var bool  skip_day       = false // v2.0a: agree=0 → skip trade
var bool  going_right    = false // bar0 went in our direction
var bool  waiting_confirm = false // waiting for bar1 confirmation
var bool  waiting_bounce  = false // waiting for dip bounce
var float dip_extreme    = na   // running low (bull) or high (bear) for bounce calc

// v2.1: Pattern-based direction overrides
var string opening_pattern = "UNKNOWN"
var int    pat_max_hold    = 7   // per-pattern max hold (default matches i_maxHold)

// ─── Daily Reset ───────────────────────────────────────────
bool newRTH = isRTH and not isRTH[1]
if newSession or (newRTH and not pmSeen)
    state             := 0
    confidence        := 0
    tier              := "—"
    hard_kill         := false
    fakeout_fired     := false
    shakeout_detected := false
    pm_high           := na
    pm_low            := na
    pm_position       := na
    pm_accel          := na
    pm_late_trend     := na
    close_929         := na
    open_929          := na
    open_927          := na
    open_925          := na
    open_920_tsla     := na
    pm_vol_5m         := 0.0
    spy_920           := na
    qqq_920           := na
    spy_929           := na
    qqq_929           := na
    gap               := na
    open_930          := na
    orig_open_930     := na
    close_935         := na
    is_hold           := false
    is_call_tier      := false
    orb_high          := na
    orb_low           := na
    orb_bull          := false
    orb_bear          := false
    bar_930_idx       := na
    entryLine         := na
    orbHighLine       := na
    orbLowLine        := na
    orb_narrow        := false
    // v2.0 resets
    pm_vwap_cv        := 0.0
    pm_vwap_v         := 0.0
    pm_vwap           := na
    pm_ema5           := na
    vwap_agrees       := false
    ema_agrees        := false
    triple_agree      := false
    agree_count       := 0
    trade_entry       := na
    peak_pnl          := 0.0
    entry_bar_idx     := na
    trade_active      := false
    trail_exited      := false
    skip_day          := false
    going_right       := false
    waiting_confirm   := false
    waiting_bounce    := false
    dip_extreme       := na
    opening_pattern   := "UNKNOWN"
    pat_max_hold      := 7

// ─── Prev Day Close ───────────────────────────────────────
if isRTH
    prev_day_close := close

// ─── STATE 0→1: Premarket Tracking ────────────────────────
if isPremarket and state == 0
    state := 1

if state == 1 and isPremarket
    if na(pm_high) or high > pm_high
        pm_high := high
    if na(pm_low) or low < pm_low
        pm_low := low

    if is0920
        open_920_tsla := open
        spy_920 := spy_close
        qqq_920 := qqq_close

    // Accumulate PM volume from 9:25 onward
    if hm >= 925 and hm <= 929
        pm_vol_5m += volume

    // v2.0: Accumulate VWAP from 9:20 onward
    if hm >= 920 and hm <= 929
        pm_vwap_cv += close * volume
        pm_vwap_v  += volume

    if is0925
        open_925 := open

    if is0927
        open_927 := open

    if is0929
        close_929 := close
        open_929  := open
        float pm_range = pm_high - pm_low
        pm_position   := pm_range > 0 ? (close - pm_low) / pm_range : 0.5
        pm_accel      := not na(open_927) ? close - open_927 : na   // v1.2: 2m window (9:27→9:29)
        pm_late_trend := not na(open_920_tsla) ? close - open_920_tsla : na
        spy_929 := spy_close
        qqq_929 := qqq_close

        // ── P9 hard kill: 30s accel from 15s sub-bars ──
        // On the 9:29 bar, sub15_close has 4 elements: [9:29:00, 9:29:15, 9:29:30, 9:29:45]
        // Last 30s direction = sub[3] vs sub[1] (9:29:45 close vs 9:29:15 close)
        bool p9_30s_down = false
        if array.size(sub15_close) >= 4
            float c_2945 = array.get(sub15_close, 3)
            float c_2915 = array.get(sub15_close, 1)
            p9_30s_down := c_2945 < c_2915
        else
            // Fallback: use 1m bar direction
            p9_30s_down := close < open

        // ── Confidence scoring (5 checks) ──
        confidence := 0
        hard_kill  := false

        // Check 1: PM Position above Q1
        if not na(pm_position) and pm_position > 0.219
            confidence += 1
        // Check 2: 2m acceleration positive (v1.2: was 4m)
        if not na(pm_accel) and pm_accel > 0
            confidence += 1
        // Check 3: VIX sweet spot
        if not na(vix_prev_close) and vix_prev_close >= 18 and vix_prev_close <= 25
            confidence += 1
        // Check 4: Triple PM alignment
        bool tsla_up = not na(pm_late_trend) and pm_late_trend > 0
        bool spy_up  = not na(spy_929) and not na(spy_920) and spy_929 > spy_920
        bool qqq_up  = not na(qqq_929) and not na(qqq_920) and qqq_929 > qqq_920
        if tsla_up and spy_up and qqq_up
            confidence += 1
        // Check 5: No gap danger
        float est_gap = not na(prev_day_close) ? close - prev_day_close : 0
        bool gapDangerFlat = est_gap < -2 and not na(pm_late_trend) and math.abs(pm_late_trend) < 0.48
        if not gapDangerFlat
            confidence += 1

        // ── Hard kills ──
        // VIX too calm
        if not na(vix_prev_close) and vix_prev_close <= 15
            hard_kill := true
        // P9 bear composite: low PM position + last 30s fading (v1.2: uses 15s sub-bars)
        if not na(pm_position) and pm_position < 0.219 and p9_30s_down
            hard_kill := true
        // Gap trap
        if gapDangerFlat
            hard_kill := true
        // v1.4b: Gap-down override — large gap-downs kill calls even when PM looks bullish
        if est_gap < -5
            hard_kill := true
        // Low PM volume — skip kill if conf>=4 (high-confidence days trade regardless)
        if pm_vol_5m < i_pmVolMinKill and pm_vol_5m > 0 and confidence < 4
            hard_kill := true

        // v1.4b: PUT rescue — strong bullish PM overrides VIX/P9 kills
        if hard_kill and not na(pm_accel) and pm_accel > 1.0 and not na(pm_position) and pm_position > 0.7 and confidence >= 3
            hard_kill := false

        // ── Tier mapping ──
        is_call_tier := not hard_kill and confidence >= 3
        tier := hard_kill ? "NO-GO" : confidence >= 5 ? "HIGH" : confidence >= 3 ? "MED" : confidence >= 2 ? "LOW" : "NO-GO"

        // ── v2.0: PM VWAP + EMA agreement ──
        pm_vwap := pm_vwap_v > 0 ? pm_vwap_cv / pm_vwap_v : close
        pm_ema5 := ta.ema(close, 5)  // EMA5 of 1m bars naturally = ~5 min lookback

        bool vwap_bull = close > pm_vwap
        bool ema_bull  = close > pm_ema5
        vwap_agrees := is_call_tier == vwap_bull
        ema_agrees  := is_call_tier == ema_bull
        triple_agree := vwap_agrees and ema_agrees
        agree_count := (vwap_agrees ? 1 : 0) + (ema_agrees ? 1 : 0)

        // v2.0: Direction + agreement sizing label
        string sz = triple_agree ? "L" : agree_count >= 1 ? "M" : "S"
        string agreeStr = triple_agree ? "3/3" : str.format("{0}/2", agree_count)
        string dirLabel = ""
        color tierColor = color.white
        string labelSize = size.normal
        if is_call_tier
            dirLabel := str.format("CALLS {0} ({1}/5) {2}", sz, confidence, agreeStr)
            tierColor := sz == "L" ? color.green : sz == "M" ? color.lime : color.gray
            labelSize := sz == "L" ? size.large : sz == "M" ? size.normal : size.small
        else
            dirLabel := str.format("PUTS {0} ({1}/5) {2}", sz, confidence, agreeStr)
            tierColor := sz == "L" ? #FF4444 : sz == "M" ? #FF6600 : color.gray
            labelSize := sz == "L" ? size.large : sz == "M" ? size.normal : size.small
        if sz == "S"
            dirLabel += " SKIP?"
        label.new(bar_index, low, dirLabel,
             style=label.style_label_up, color=tierColor, textcolor=color.white, size=labelSize)

        // Log: detailed pre-scan
        string chk1 = not na(pm_position) and pm_position > 0.219 ? "1" : "0"
        string chk2 = not na(pm_accel) and pm_accel > 0 ? "1" : "0"
        string chk3 = not na(vix_prev_close) and vix_prev_close >= 18 and vix_prev_close <= 25 ? "1" : "0"
        string chk4 = tsla_up and spy_up and qqq_up ? "1" : "0"
        string chk5 = not gapDangerFlat ? "1" : "0"
        string alignStr = str.format("T{0}S{1}Q{2}", tsla_up?"↑":"↓", spy_up?"↑":"↓", qqq_up?"↑":"↓")
        string killReason = not hard_kill ? "none" : (not na(vix_prev_close) and vix_prev_close <= 15 ? "VIX" : pm_vol_5m < i_pmVolMinKill and pm_vol_5m > 0 ? "LOW_VOL" : gapDangerFlat ? "GAP" : "P9")
        logMsg(str.format("PRE-SCAN tier={0} conf={1}/5 checks={2}{3}{4}{5}{6} kill={7}({8}) vix={9} pm_pos={10} pm_acc={11} pm_trend={12} gap={13} align={14} pm_vol={15} p9_30s={16} vwap={17} ema5={18} agree={19}",
             tier, confidence, chk1, chk2, chk3, chk4, chk5,
             hard_kill ? "Y" : "N", killReason,
             str.tostring(nz(vix_prev_close), "#.#"),
             str.tostring(nz(pm_position), "#.###"),
             str.tostring(nz(pm_accel), "#.##"),
             str.tostring(nz(pm_late_trend), "#.##"),
             str.tostring(nz(est_gap), "#.##"),
             alignStr,
             str.tostring(pm_vol_5m, "#"),
             p9_30s_down ? "DN" : "UP",
             str.tostring(nz(pm_vwap), "#.##"),
             str.tostring(nz(pm_ema5), "#.##"),
             str.format("{0}/2", agree_count)))

// Extended Hours warning
if is0930 and not pmSeen
    label.new(bar_index, high, "⚠ Extended Hours OFF",
         style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.normal)

// ─── STATE 2: OPENING (9:30) ──────────────────────────────
if is0930 and state == 1
    open_930      := open
    orig_open_930 := open
    bar_930_idx   := bar_index
    gap := not na(prev_day_close) ? open - prev_day_close : na
    state := 2

    // Start ORB tracking with this bar
    orb_high := high
    orb_low  := low

    // v2.1: Classify bar0 pattern (CRASH/SURGE identifiable at bar0 close)
    float bar0_range = high - low
    if close < open and bar0_range > 2.50
        opening_pattern := "CRASH"
        is_call_tier    := false  // override binary conf: CRASH → always PUT
        pat_max_hold    := 7
    else if close >= open and bar0_range > 2.50
        opening_pattern := "SURGE"
        is_call_tier    := true   // override binary conf: SURGE → always CALL
        pat_max_hold    := 20     // SURGE holds longer (research peak at 14m)

    logMsg(str.format("OPENING entry={0} gap={1} tier={2} direction={3} agree={4}/2 pat={5}",
         str.tostring(open_930, "#.##"), str.tostring(nz(gap), "#.##"), tier,
         is_call_tier ? "CALL" : "PUT", agree_count, opening_pattern))

    // Draw entry line
    entryLine := line.new(bar_index, open_930, bar_index + 25, open_930,
                 color=is_call_tier ? #00BFFF : #FF6600, width=3, style=line.style_solid)
    label.new(bar_index + 25, open_930, str.format("entry {0,number,#.##}", open_930),
         style=label.style_label_left, color=is_call_tier ? #00BFFF : #FF6600, textcolor=color.white, size=size.small)

    // v2.0a: Skip trade on S tier (agree=0/2 — VWAP+EMA both disagree with binary)
    skip_day := agree_count == 0 and not triple_agree
    // v2.1: Never skip CRASH/SURGE — direction is always reliable for these patterns
    if opening_pattern == "CRASH" or opening_pattern == "SURGE"
        skip_day := false
    if skip_day
        label.new(bar_index, is_call_tier ? high + labelOff : low - labelOff,
             "SKIP — 0/2 agree",
             style=is_call_tier ? label.style_label_down : label.style_label_up,
             color=color.gray, textcolor=color.white, size=size.small)
        logMsg("SKIP — agreement 0/2, no trade")
        state := 5  // jump to DONE

    // v2.0: Non-smart entry — enter immediately at open
    if not i_smartEntry and not skip_day
        trade_entry   := open_930
        trade_active  := true
        entry_bar_idx := bar_index
        string entryDir = is_call_tier ? "CALL" : "PUT"
        label.new(bar_index, is_call_tier ? low : high + labelOff,
             str.format("ENTERED {0} — {1,number,#.##}", entryDir, open_930),
             style=is_call_tier ? label.style_label_up : label.style_label_down,
             color=is_call_tier ? #00BFFF : #FF6600, textcolor=color.white, size=size.large)
        alert(str.format("TSLA {0} — entered at {1,number,#.##}", entryDir, open_930), alert.freq_once_per_bar)
        state := 4  // skip to ACTIVE

    // v2.1: Force immediate entry for CRASH/SURGE on smart-entry mode
    // (these patterns are direction-reliable — no need to wait for bar1 confirm)
    if i_smartEntry and not skip_day and not trade_active and
         (opening_pattern == "CRASH" or opening_pattern == "SURGE")
        trade_entry   := open_930
        trade_active  := true
        entry_bar_idx := bar_index
        string patDir = is_call_tier ? "CALL" : "PUT"
        label.new(bar_index, is_call_tier ? low : high + labelOff,
             str.format("{0} {1} — {2,number,#.##}", opening_pattern, patDir, open_930),
             style=is_call_tier ? label.style_label_up : label.style_label_down,
             color=is_call_tier ? #00BFFF : #FF6600, textcolor=color.white, size=size.large)
        alert(str.format("TSLA {0} {1} — entered at {2,number,#.##}", opening_pattern, patDir, open_930), alert.freq_once_per_bar)
        logMsg(str.format("CRASH/SURGE IMMEDIATE ENTRY pat={0} dir={1} open={2}", opening_pattern, patDir, str.tostring(open_930, "#.##")))
        state := 4  // skip to ACTIVE

// ─── STATE 3: ENTRY WATCH (9:30 bar close) ─────────────────
// v2.0: Smart entry — check bar0 direction, decide confirm vs bounce
if is0930 and state == 2
    state := 3

    if i_smartEntry and not skip_day
        // Check if bar0 went in our direction
        if is_call_tier
            going_right := close >= orig_open_930  // bar0 bullish
        else
            going_right := close <= orig_open_930  // bar0 bearish

        if going_right
            waiting_confirm := true  // wait for bar1 at 9:31 to confirm
            logMsg(str.format("SMART ENTRY: going right, waiting for bar1 confirm. close={0} open={1}",
                 str.tostring(close, "#.##"), str.tostring(orig_open_930, "#.##")))
        else
            waiting_bounce := true   // price went wrong, wait for bounce
            dip_extreme := is_call_tier ? low : high
            logMsg(str.format("SMART ENTRY: going wrong, waiting for bounce. close={0} open={1} extreme={2}",
                 str.tostring(close, "#.##"), str.tostring(orig_open_930, "#.##"),
                 str.tostring(dip_extreme, "#.##")))

    // Use real 30s sub-bars if available for fakeout detection (informational)
    bool has30s = array.size(sub30_open) >= 2
    float bar1_range = high - low

    if has30s
        float b1_open  = array.get(sub30_open, 0)
        float b1_high  = array.get(sub30_high, 0)
        float b1_low   = array.get(sub30_low, 0)
        float b1_close = array.get(sub30_close, 0)
        float b2_open  = array.get(sub30_open, 1)
        float b2_low   = array.get(sub30_low, 1)
        float b2_close = array.get(sub30_close, 1)
        bool b1_up   = b1_close >= b1_open
        bool b1_down = b1_close < b1_open
        bool b2_down = b2_close < b2_open
        float b1_rng = b1_high - b1_low

        if b1_up and b2_down and b2_low < b1_low
            fakeout_fired := true
        if b1_down and b2_down and not (b1_rng > 3.04)
            shakeout_detected := true
    else
        bool bar1_red = close < open
        float bar1_upper_wick = high - math.max(open, close)
        float bar1_body_size = math.abs(close - open)
        bool bar1_rejection = bar1_upper_wick > bar1_body_size and bar1_body_size > 0
        if bar1_red and bar1_rejection
            fakeout_fired := true
        bool bar1_chaotic = bar1_range > 3.04
        if bar1_red and not bar1_rejection and not bar1_chaotic
            shakeout_detected := true

    // Fakeout info label (informational only in v2.0 — trail handles exits)
    if fakeout_fired
        label.new(bar_index, high, "FAKEOUT — watch",
             style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.normal)

    logMsg(str.format("BAR0 fakeout={0} shakeout={1} range={2} going_right={3}",
         fakeout_fired ? "Y" : "N", shakeout_detected ? "Y" : "N",
         str.tostring(bar1_range, "#.##"), going_right ? "Y" : "N"))

// ─── Smart Entry: Bar1 Confirmation (9:31) ─────────────────
if waiting_confirm and h == 9 and m == 31 and state == 3
    // Check: did bar1 continue in our direction?
    bool bar1_confirms = is_call_tier ? (close > close[1]) : (close < close[1])
    if bar1_confirms
        trade_entry   := close
        trade_active  := true
        entry_bar_idx := bar_index
        waiting_confirm := false
        state := 4
        string entryDir = is_call_tier ? "CALL" : "PUT"
        label.new(bar_index, is_call_tier ? low : high + labelOff,
             str.format("CONFIRMED {0} — {1,number,#.##}", entryDir, trade_entry),
             style=is_call_tier ? label.style_label_up : label.style_label_down,
             color=color.green, textcolor=color.white, size=size.large)
        alert(str.format("TSLA {0} CONFIRMED — entered at {1,number,#.##}", entryDir, trade_entry), alert.freq_once_per_bar)
        logMsg(str.format("SMART ENTRY CONFIRMED close={0} dir={1}",
             str.tostring(close, "#.##"), entryDir))
    else
        waiting_confirm := false
        state := 5  // DONE — no entry today
        label.new(bar_index, high + labelOff, "STALLED — no entry",
             style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
        logMsg(str.format("SMART ENTRY STALLED bar1 did not confirm. close={0} prev={1}",
             str.tostring(close, "#.##"), str.tostring(close[1], "#.##")))

// ─── Smart Entry: Bounce Detection (9:31-9:37) ─────────────
if waiting_bounce and hm >= 931 and hm <= 937 and not trade_active
    // Update extreme
    if is_call_tier and low < dip_extreme
        dip_extreme := low
    if not is_call_tier and high > dip_extreme
        dip_extreme := high

    // Check for bounce
    float dip_size = is_call_tier ? (orig_open_930 - dip_extreme) : (dip_extreme - orig_open_930)
    float bounce_level = is_call_tier ? (dip_extreme + dip_size * i_bounceRecov / 100) : (dip_extreme - dip_size * i_bounceRecov / 100)

    if dip_size > 0.10  // need at least $0.10 dip
        bool bounced = is_call_tier ? (close >= bounce_level) : (close <= bounce_level)
        if bounced and not trade_active
            trade_entry   := close
            trade_active  := true
            entry_bar_idx := bar_index
            waiting_bounce := false
            state := 4
            string entryDir = is_call_tier ? "CALL" : "PUT"
            label.new(bar_index, is_call_tier ? low : high + labelOff,
                 str.format("BOUNCE {0} — {1,number,#.##}", entryDir, trade_entry),
                 style=is_call_tier ? label.style_label_up : label.style_label_down,
                 color=color.teal, textcolor=color.white, size=size.large)
            alert(str.format("TSLA {0} BOUNCE — entered at {1,number,#.##}", entryDir, trade_entry), alert.freq_once_per_bar)
            logMsg(str.format("SMART ENTRY BOUNCE close={0} extreme={1} dip={2} bounce_level={3}",
                 str.tostring(close, "#.##"), str.tostring(dip_extreme, "#.##"),
                 str.tostring(dip_size, "#.##"), str.tostring(bounce_level, "#.##")))

// Bounce timeout — no bounce by 9:37 → skip
if waiting_bounce and hm == 937 and not trade_active
    waiting_bounce := false
    state := 5  // DONE
    label.new(bar_index, high + labelOff, "NO BOUNCE — skip",
         style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
    logMsg(str.format("BOUNCE TIMEOUT no entry by 9:37, extreme={0}",
         str.tostring(nz(dip_extreme), "#.##")))

// ─── ORB BUILD (9:31–9:34) ─────────────────────────────────
// Track the 5-minute opening range high/low (informational in v2.0)
if isORBBuild or is0930
    if not na(orb_high) and high > orb_high
        orb_high := high
    if not na(orb_low) and low < orb_low
        orb_low := low

// ─── ORB FREEZE (at 9:34) ──────────────────────────────────
if is0934
    // Include 9:34 bar in ORB (last bar of the 5m range)
    if not na(orb_high) and high > orb_high
        orb_high := high
    if not na(orb_low) and low < orb_low
        orb_low := low

    // Freeze ORB — draw lines + shaded zone
    if not na(bar_930_idx)
        orbHighLine := line.new(bar_930_idx, orb_high, bar_930_idx + 25, orb_high,
                     color=color.yellow, width=2, style=line.style_dashed)
        orbLowLine  := line.new(bar_930_idx, orb_low, bar_930_idx + 25, orb_low,
                     color=color.yellow, width=2, style=line.style_dashed)
        linefill.new(orbHighLine, orbLowLine, color=color.new(color.yellow, 90))

    // v1.2: Check min ORB width
    float orb_width = nz(orb_high) - nz(orb_low)
    orb_narrow := orb_width < i_minOrbWidth

    // 5m rule: close of 9:34 bar vs original 9:30 open (5 minutes of trading)
    close_935 := close
    is_hold := not na(close_935) and not na(orig_open_930) and close_935 > orig_open_930

    // 5m info label at 9:34 bar
    string fiveMinTxt = is_hold ? "5m: above" : "5m: below"
    if orb_narrow
        fiveMinTxt += " | ORB narrow"
    color fiveMinCol = is_hold ? color.green : color.orange
    label.new(bar_index, high + labelOff, fiveMinTxt,
         style=label.style_label_down, color=fiveMinCol, textcolor=color.white, size=size.small)

    logMsg(str.format("ORB FROZEN H={0} L={1} width={2} 5m={3} close={4} orig_open={5} narrow={6}",
         str.tostring(nz(orb_high), "#.##"), str.tostring(nz(orb_low), "#.##"),
         str.tostring(orb_width, "#.##"),
         is_hold ? "HOLD" : "BAIL", str.tostring(close_935, "#.##"),
         str.tostring(nz(orig_open_930), "#.##"),
         orb_narrow ? "Y" : "N"))

// ─── ORB Breakout Detection (informational, after 9:35) ────
// v2.0: breakout labels are informational — trail handles actual exits
if hm >= 935 and hm <= 955 and not orb_narrow and not na(orb_high) and not na(orb_low)
    // Bull breakout: close above ORB high
    if not orb_bull and not orb_bear and close > orb_high
        orb_bull := true
        label.new(bar_index, low - labelOff * 2, "ORB BULL BREAK",
             style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)
        alert(str.format("TSLA ORB BULL BREAK at {0,number,#.##}", close), alert.freq_once_per_bar)
        logMsg(str.format("ORB BULL BREAK close={0} > orbH={1}",
             str.tostring(close, "#.##"), str.tostring(orb_high, "#.##")))

    // Bear breakout: close below ORB low
    if not orb_bull and not orb_bear and close < orb_low
        orb_bear := true
        label.new(bar_index, high + labelOff * 2, "ORB BEAR BREAK",
             style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)
        alert(str.format("TSLA ORB BEAR BREAK at {0,number,#.##}", close), alert.freq_once_per_bar)
        logMsg(str.format("ORB BEAR BREAK close={0} < orbL={1}",
             str.tostring(close, "#.##"), str.tostring(orb_low, "#.##")))

// ─── STATE 4: ACTIVE — Trail Exit Engine ───────────────────
// v2.0: On each bar after entry, track PnL and trail stop
if trade_active and not trail_exited and not na(trade_entry) and state == 4
    int bars_held = bar_index - entry_bar_idx

    // Compute current PnL
    float cur_pnl = is_call_tier ? (close - trade_entry) : (trade_entry - close)

    // Update peak
    if cur_pnl > peak_pnl
        peak_pnl := cur_pnl

    // Exit logic
    bool should_exit = false
    string exit_reason = ""

    if i_exitMethod == "Trail"
        // Trail: exit when PnL drops trail_amt from peak (checked on 1m bar close)
        if bars_held >= 1 and peak_pnl > 0 and cur_pnl <= peak_pnl - i_trailAmt
            should_exit := true
            exit_reason := "TRAIL"
        // Max hold (v2.1: per-pattern, default=i_maxHold, SURGE=20)
        if bars_held >= pat_max_hold
            should_exit := true
            exit_reason := exit_reason == "" ? "MAX HOLD" : exit_reason
    else
        // Fixed exit
        int fix_bars = i_exitMethod == "Fixed 1m" ? 1 : i_exitMethod == "Fixed 2m" ? 2 : 3
        if bars_held >= fix_bars
            should_exit := true
            exit_reason := str.format("FIXED {0}m", fix_bars)

    if should_exit
        trail_exited := true
        trade_active := false
        state := 5  // DONE
        label.new(bar_index, is_call_tier ? high + labelOff : low - labelOff,
             str.format("EXIT {0} — ${1,number,#.##} ({2}m)", exit_reason, cur_pnl, bars_held),
             style=is_call_tier ? label.style_label_down : label.style_label_up,
             color=cur_pnl > 0 ? color.green : color.red,
             textcolor=color.white, size=size.large)
        alert(str.format("TSLA EXIT {0} — P&L ${1,number,#.##}", exit_reason, cur_pnl), alert.freq_once_per_bar)
        logMsg(str.format("EXIT {0} close={1} entry={2} pnl={3} bars={4} peak={5}",
             exit_reason, str.tostring(close, "#.##"), str.tostring(trade_entry, "#.##"),
             str.tostring(cur_pnl, "#.##"), bars_held, str.tostring(peak_pnl, "#.##")))

// ─── Timeout: no breakout/exit by 9:55 → done ──────────────
if state == 3 and hm >= 955
    if waiting_confirm
        waiting_confirm := false
    if waiting_bounce
        waiting_bounce := false
    label.new(bar_index, high, "TIMEOUT — no entry",
         style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
    logMsg("TIMEOUT state=3 no entry by 9:55")
    state := 5

// ─── STATE 5: DONE ─────────────────────────────────────────
// Nothing — all lines/labels remain visible

// ─── Background Colors ─────────────────────────────────────
color bgColor = na
if i_showBG and isActiveWindow
    if state == 1
        bgColor := tier == "—" ? color.new(color.gray, 95) :
                   tier == "NO-GO" ? color.new(color.red, 92) :
                   color.new(color.green, 92)
    else if state == 2 or state == 3
        if fakeout_fired and is_call_tier
            bgColor := color.new(color.red, 85)
        else if not is_call_tier
            bgColor := color.new(#FF6600, 90)  // orange bg for PUT days
        else
            bgColor := tier == "NO-GO" ? color.new(color.red, 92) : color.new(color.green, 92)
    else if state == 4
        // Active trade — green for CALL, orange for PUT
        bgColor := is_call_tier ? color.new(color.green, 90) : color.new(#FF6600, 90)

bgcolor(bgColor)

// ─── Corner Table ──────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 5,
     bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if i_showTable and (isRTH or isActiveWindow)
    table.cell(infoTable, 0, 0, "TSLA OPEN SCALP", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "v2.1", text_color=color.gray, text_size=size.tiny)

    string stateStr = state == 0 ? "SLEEP" : state == 1 ? "PRE-SCAN" :
                      state == 2 ? "OPENING" : state == 3 ? "ENTRY WATCH" :
                      state == 4 ? "ACTIVE" : "DONE"
    color stateColor = state == 4 ? (is_call_tier ? color.green : #FF6600) :
                       tier == "HIGH" ? color.green : tier == "MED" ? color.lime :
                       tier == "LOW" ? color.gray : tier == "NO-GO" ? color.red : color.white

    // Row 1: State + Tier + agreement + pattern
    string patStr = opening_pattern != "UNKNOWN" ? " " + opening_pattern : ""
    string tierAgree = tier != "—" ? str.format("{0} ({1}/5) {2}{3}", tier, confidence, triple_agree ? "3/3" : str.format("{0}/2", agree_count), patStr) : ""
    table.cell(infoTable, 0, 1, stateStr, text_color=stateColor, text_size=size.normal)
    table.cell(infoTable, 1, 1, tierAgree, text_color=stateColor, text_size=size.small)

    // Row 2: VIX
    string vixStr = not na(vix_prev_close) ? str.format("VIX: {0,number,#.#}", vix_prev_close) : "VIX: N/A"
    color vixColor = not na(vix_prev_close) ? (vix_prev_close <= 15 ? color.red : vix_prev_close >= 18 and vix_prev_close <= 25 ? color.green : color.gray) : color.gray
    table.cell(infoTable, 0, 2, vixStr, text_color=vixColor, text_size=size.small)
    table.cell(infoTable, 1, 2, "", text_color=color.white, text_size=size.small)

    // Row 3: PM info, ORB info, or Trail info
    if state <= 3 and not trade_active
        string pmStr = not na(pm_position) ? str.format("PM: pos={0,number,#.##} acc={1,number,#.#}", pm_position, nz(pm_accel)) : "PM: waiting..."
        table.cell(infoTable, 0, 3, pmStr, text_color=color.white, text_size=size.small)
        // Show VWAP/EMA agreement
        string agreeInfo = not na(pm_vwap) ? str.format("VWAP:{0} EMA:{1}", vwap_agrees ? "Y" : "N", ema_agrees ? "Y" : "N") : ""
        table.cell(infoTable, 1, 3, agreeInfo, text_color=triple_agree ? color.green : agree_count >= 1 ? color.lime : color.gray, text_size=size.small)
    else if trade_active and not na(trade_entry)
        // Active trade: show trail info
        float cur_pnl_tbl = is_call_tier ? (close - trade_entry) : (trade_entry - close)
        float trail_level = peak_pnl - i_trailAmt
        color pnlColor = cur_pnl_tbl > 0 ? color.green : color.red
        table.cell(infoTable, 0, 3, str.format("PnL: ${0,number,#.##} | Peak: ${1,number,#.##}", cur_pnl_tbl, peak_pnl),
             text_color=pnlColor, text_size=size.small)
        table.cell(infoTable, 1, 3, i_exitMethod == "Trail" ? str.format("Trail: ${0,number,#.##}", trail_level) : i_exitMethod,
             text_color=color.yellow, text_size=size.small)
    else if not na(orb_high)
        table.cell(infoTable, 0, 3, str.format("ORB: {0,number,#.##} — {1,number,#.##}", orb_high, orb_low),
             text_color=color.yellow, text_size=size.small)
        table.cell(infoTable, 1, 3, "", text_color=color.white, text_size=size.small)
    else
        table.cell(infoTable, 0, 3, "", text_color=color.white, text_size=size.small)
        table.cell(infoTable, 1, 3, "", text_color=color.white, text_size=size.small)

    // Row 4: Entry/Exit info
    if trade_active and not na(trade_entry)
        int barsIn = bar_index - entry_bar_idx
        table.cell(infoTable, 0, 4, str.format("Entry: {0,number,#.##} ({1}m ago)", trade_entry, barsIn),
             text_color=color.white, text_size=size.small)
        table.cell(infoTable, 1, 4, "", text_color=color.white, text_size=size.small)
    else if trail_exited and not na(trade_entry)
        float final_pnl = is_call_tier ? (close - trade_entry) : (trade_entry - close)
        table.cell(infoTable, 0, 4, str.format("EXITED — peak ${0,number,#.##}", peak_pnl),
             text_color=peak_pnl > 0 ? color.green : color.red, text_size=size.small)
        table.cell(infoTable, 1, 4, "", text_color=color.white, text_size=size.small)
    else if state <= 1
        bool tsla_up_t = not na(pm_late_trend) and pm_late_trend > 0
        bool spy_up_t  = not na(spy_929) and not na(spy_920) and spy_929 > spy_920
        bool qqq_up_t  = not na(qqq_929) and not na(qqq_920) and qqq_929 > qqq_920
        table.cell(infoTable, 0, 4, str.format("Align: T{0} S{1} Q{2}",
             tsla_up_t ? "↑" : "↓", spy_up_t ? "↑" : "↓", qqq_up_t ? "↑" : "↓"),
             text_color=color.white, text_size=size.small)
        table.cell(infoTable, 1, 4, "", text_color=color.white, text_size=size.small)
    else if not na(orig_open_930)
        table.cell(infoTable, 0, 4, str.format("Open: {0,number,#.##}", orig_open_930),
             text_color=color.white, text_size=size.small)
        table.cell(infoTable, 1, 4, "", text_color=color.white, text_size=size.small)
    else
        table.cell(infoTable, 0, 4, "", text_color=color.white, text_size=size.small)
        table.cell(infoTable, 1, 4, "", text_color=color.white, text_size=size.small)

if not isRTH and not isPremarket
    table.clear(infoTable, 0, 0, 1, 4)

// ─── Alerts ────────────────────────────────────────────────
if is0929 and state == 1
    string sz_alert = triple_agree ? "L" : agree_count >= 1 ? "M" : "S"
    if is_call_tier
        alert(str.format("TSLA CALLS {0}: {1} ({2}/5) — agree {3}", sz_alert, tier, confidence, triple_agree ? "3/3" : str.format("{0}/2", agree_count)), alert.freq_once_per_bar)
    else
        string reason = hard_kill ? (not na(vix_prev_close) and vix_prev_close <= 15 ? "VIX <= 15" :
                       (pm_vol_5m < i_pmVolMinKill and pm_vol_5m > 0 ? "low PM vol" :
                       (not na(pm_position) and pm_position < 0.219 ? "P9 bear" : "gap trap"))) : "low score"
        alert(str.format("TSLA PUTS {0}: {1} ({2}/5) — {3} — agree {4}", sz_alert, tier, confidence, reason, triple_agree ? "3/3" : str.format("{0}/2", agree_count)), alert.freq_once_per_bar)
// Trail/entry alerts are inline above
