// © TSLA Open Scalper
// 0DTE/1DTE opening trade decision system (v1.1a)
// v1.1a: ORB-based breakout replaces fixed-time 5m BAIL
// Designed for TSLA on 1-min chart with Extended Hours ON
//@version=6
indicator("TSLA Open Scalper v1.1a", overlay=true, max_labels_count=50, max_lines_count=20)

// ─── Inputs ────────────────────────────────────────────────
i_vixSymbol = input.string("CBOE:VIX", "VIX Symbol", tooltip="VIX data provider. Try TVC:VIX if CBOE:VIX fails.", group="Data")
i_slDistance = input.float(2.0, "Stop Loss Distance ($)", minval=0.5, step=0.5, tooltip="Distance below entry for SL line. Research: median max dip on HOLD days = $2.08", group="Trade")
i_showTable = input.bool(true, "Show Info Table", group="Visuals")
i_showBG    = input.bool(true, "Show Background Colors", group="Visuals")

// ─── External Data ─────────────────────────────────────────
vix_prev_close = request.security(i_vixSymbol, "D", close[1], lookahead=barmerge.lookahead_on)
spy_close      = request.security("SPY", "1", close)
qqq_close      = request.security("QQQ", "1", close)

// ─── Timezone & Session Detection ──────────────────────────
TZ = "America/New_York"

int h  = hour(time, TZ)
int m  = minute(time, TZ)
int hm = h * 100 + m

isPremarket    = hm >= 400 and hm <= 929
isRTH          = hm >= 930 and hm <= 1559
newSession     = isPremarket and not isPremarket[1]
is0920         = h == 9 and m == 20
is0925         = h == 9 and m == 25
is0929         = h == 9 and m == 29
is0930         = h == 9 and m == 30
is0935         = h == 9 and m == 35
isORBBuild     = hm >= 931 and hm <= 934
isActiveWindow = hm >= 920 and hm <= 955

// ─── Extended Hours Guard ──────────────────────────────────
var bool pmSeen = false
if isPremarket
    pmSeen := true
if newSession
    pmSeen := false

// ─── State Machine ─────────────────────────────────────────
// 0=SLEEP, 1=PRE_SCAN, 2=OPENING, 3=FAKEOUT, 4=ORB_BUILD,
// 5=ORB_WATCH, 6=BREAKOUT, 7=DONE
var int    state         = 0
var int    confidence    = 0
var string tier          = "—"
var bool   hard_kill     = false
var bool   fakeout_fired = false
var bool   shakeout_detected = false

// Premarket tracking
var float pm_high       = na
var float pm_low        = na
var float pm_position   = na
var float pm_accel      = na
var float pm_late_trend = na
var float close_929     = na
var float open_925      = na
var float open_920_tsla = na

// Cross-symbol PM
var float spy_920       = na
var float qqq_920       = na
var float spy_929       = na
var float qqq_929       = na

// Session / entry
var float prev_day_close = na
var float gap            = na
var float open_930       = na
var float close_935      = na
var bool  is_hold        = false

// ORB tracking
var float orb_high       = na
var float orb_low        = na
var bool  orb_bull       = false   // bull breakout detected
var bool  orb_bear       = false   // bear breakout detected
var int   breakout_bar   = na      // bar_index of breakout
var int   bar_930_idx    = na      // bar_index at 9:30

// Visual object IDs
var line  entryLine      = na
var line  slLine         = na
var line  orbHighLine    = na
var line  orbLowLine     = na

// ─── Daily Reset ───────────────────────────────────────────
bool newRTH = isRTH and not isRTH[1]
if newSession or (newRTH and not pmSeen)
    state             := 0
    confidence        := 0
    tier              := "—"
    hard_kill         := false
    fakeout_fired     := false
    shakeout_detected := false
    pm_high           := na
    pm_low            := na
    pm_position       := na
    pm_accel          := na
    pm_late_trend     := na
    close_929         := na
    open_925          := na
    open_920_tsla     := na
    spy_920           := na
    qqq_920           := na
    spy_929           := na
    qqq_929           := na
    gap               := na
    open_930          := na
    close_935         := na
    is_hold           := false
    orb_high          := na
    orb_low           := na
    orb_bull          := false
    orb_bear          := false
    breakout_bar      := na
    bar_930_idx       := na
    entryLine         := na
    slLine            := na
    sl_hit            := false
    orbHighLine       := na
    orbLowLine        := na

// ─── Prev Day Close ───────────────────────────────────────
if isRTH
    prev_day_close := close

// ─── STATE 0→1: Premarket Tracking ────────────────────────
if isPremarket and state == 0
    state := 1

if state == 1 and isPremarket
    if na(pm_high) or high > pm_high
        pm_high := high
    if na(pm_low) or low < pm_low
        pm_low := low

    if is0920
        open_920_tsla := open
        spy_920 := spy_close
        qqq_920 := qqq_close

    if is0925
        open_925 := open

    if is0929
        close_929 := close
        float pm_range = pm_high - pm_low
        pm_position   := pm_range > 0 ? (close - pm_low) / pm_range : 0.5
        pm_accel      := not na(open_925) ? close - open_925 : na
        pm_late_trend := not na(open_920_tsla) ? close - open_920_tsla : na
        spy_929 := spy_close
        qqq_929 := qqq_close

        // ── Confidence scoring ──
        confidence := 0
        hard_kill  := false

        if not na(pm_position) and pm_position > 0.219
            confidence += 1
        if not na(pm_accel) and pm_accel > 0
            confidence += 1
        if not na(vix_prev_close) and vix_prev_close >= 18 and vix_prev_close <= 25
            confidence += 1

        bool tsla_up = not na(pm_late_trend) and pm_late_trend > 0
        bool spy_up  = not na(spy_929) and not na(spy_920) and spy_929 > spy_920
        bool qqq_up  = not na(qqq_929) and not na(qqq_920) and qqq_929 > qqq_920
        if tsla_up and spy_up and qqq_up
            confidence += 1

        float est_gap = not na(prev_day_close) ? close - prev_day_close : 0
        bool gapDangerFlat = est_gap < -2 and not na(pm_late_trend) and math.abs(pm_late_trend) < 0.48
        if not gapDangerFlat
            confidence += 1

        if not na(vix_prev_close) and vix_prev_close <= 15
            hard_kill := true
        if not na(pm_position) and pm_position < 0.219 and not na(pm_accel) and pm_accel < 0
            hard_kill := true
        if gapDangerFlat
            hard_kill := true

        tier := hard_kill ? "NO-GO" : confidence >= 5 ? "HIGH" : confidence >= 3 ? "MED" : confidence >= 2 ? "LOW" : "NO-GO"

        color tierColor = tier == "HIGH" ? color.green : tier == "MED" ? color.lime : tier == "LOW" ? color.gray : color.red
        label.new(bar_index, low, str.format("{0} ({1}/5)", tier, confidence),
             style=label.style_label_up, color=tierColor, textcolor=color.white, size=size.normal)

// Extended Hours warning
if is0930 and not pmSeen
    label.new(bar_index, high, "⚠ Extended Hours OFF",
         style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.normal)

// ─── STATE 2: OPENING (9:30) ──────────────────────────────
if is0930 and state == 1
    open_930    := open
    bar_930_idx := bar_index
    gap := not na(prev_day_close) ? open - prev_day_close : na
    state := 2

    // Start ORB tracking with this bar
    orb_high := high
    orb_low  := low

    // Draw entry + SL lines
    if tier == "HIGH" or tier == "MED"
        entryLine := line.new(bar_index, open_930, bar_index + 25, open_930,
                     color=#00BFFF, width=3, style=line.style_solid)
        slLine    := line.new(bar_index, open_930 - i_slDistance, bar_index + 25, open_930 - i_slDistance,
                     color=#FF4444, width=3, style=line.style_solid)
        label.new(bar_index + 25, open_930, str.format("entry {0,number,#.##}", open_930),
             style=label.style_label_left, color=#00BFFF, textcolor=color.white, size=size.small)
        label.new(bar_index + 25, open_930 - i_slDistance, str.format("SL {0,number,#.##}", open_930 - i_slDistance),
             style=label.style_label_left, color=#FF4444, textcolor=color.white, size=size.small)
        label.new(bar_index, low, "ENTERED (small)",
             style=label.style_label_up, color=#00BFFF, textcolor=color.white, size=size.normal)
    else if tier == "LOW"
        entryLine := line.new(bar_index, open_930, bar_index + 25, open_930,
                     color=color.gray, width=2, style=line.style_dashed)
        label.new(bar_index, low, "WATCHING",
             style=label.style_label_up, color=color.gray, textcolor=color.white, size=size.normal)

// ─── STATE 3: FAKEOUT CHECK (9:30 bar close) ──────────────
if is0930 and state == 2
    state := 3
    float bar1_body = close - open
    float bar1_range = high - low
    float bar1_upper_wick = high - math.max(open, close)
    float bar1_body_size = math.abs(bar1_body)
    bool bar1_red = close < open
    bool bar1_chaotic = bar1_range > 3.04
    bool bar1_rejection = bar1_upper_wick > bar1_body_size and bar1_body_size > 0

    if bar1_red and bar1_rejection
        fakeout_fired := true
        label.new(bar_index, high, "EXIT — FAKEOUT",
             style=label.style_label_down, color=color.red, textcolor=color.white, size=size.large)

    if bar1_chaotic and not fakeout_fired
        label.new(bar_index, high, "⚠ CHAOTIC",
             style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)

    if bar1_red and not bar1_rejection and not bar1_chaotic
        shakeout_detected := true
        label.new(bar_index, low, "shakeout — watch",
             style=label.style_label_up, color=color.gray, textcolor=color.white, size=size.tiny)

// ─── STATE 4: ORB BUILD (9:31–9:34) ───────────────────────
// Track the 5-minute opening range high/low
if state == 3 and isORBBuild
    state := 4

if state == 4 and isORBBuild
    if high > orb_high
        orb_high := high
    if low < orb_low
        orb_low := low

// ─── STATE 5: ORB WATCH (9:35+) ───────────────────────────
// ORB complete — draw the box, show 5m info, watch for breakout
if is0935 and (state == 3 or state == 4)
    // Include 9:35 bar in ORB (it's the close of the 5m range)
    if high > orb_high
        orb_high := high
    if low < orb_low
        orb_low := low

    // Freeze ORB — draw lines + shaded zone
    orbHighLine := line.new(bar_930_idx, orb_high, bar_930_idx + 25, orb_high,
                 color=color.yellow, width=2, style=line.style_dashed)
    orbLowLine  := line.new(bar_930_idx, orb_low, bar_930_idx + 25, orb_low,
                 color=color.yellow, width=2, style=line.style_dashed)
    linefill.new(orbHighLine, orbLowLine, color=color.new(color.yellow, 90))

    // 5m rule as info (not primary signal anymore)
    close_935 := close
    is_hold := not na(close_935) and not na(open_930) and close_935 > open_930

    // Show 5m info label (small, informational)
    string fiveMinInfo = is_hold ? "5m: above open ✓" : "5m: below open ✗"
    color fiveMinColor = is_hold ? color.green : color.orange
    label.new(bar_index, is_hold ? low : high, fiveMinInfo,
         style=is_hold ? label.style_label_up : label.style_label_down,
         color=fiveMinColor, textcolor=color.white, size=size.small)

    // ORB formed label
    label.new(bar_index, orb_high, str.format("ORB H {0,number,#.##}", orb_high),
         style=label.style_label_down, color=color.yellow, textcolor=color.black, size=size.tiny)
    label.new(bar_index, orb_low, str.format("ORB L {0,number,#.##}", orb_low),
         style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.tiny)

    state := 5

// ─── SL Hit Detection (states 3-5) ─────────────────────────
// If price hits SL before ORB breakout, warn immediately — don't wait
var bool sl_hit = false
if (state >= 3 and state <= 5) and not sl_hit and not na(open_930) and low <= (open_930 - i_slDistance)
    sl_hit := true
    label.new(bar_index, high, "⚠ SL HIT — EXIT",
         style=label.style_label_down, color=#FF4444, textcolor=color.white, size=size.large)
    alert(str.format("TSLA SL HIT at {0,number,#.##} — EXIT NOW", open_930 - i_slDistance), alert.freq_once_per_bar)

// ─── Breakout detection (state 5, each bar after 9:35) ────
if state == 5 and hm >= 936 and hm <= 955
    // Bull breakout: close above ORB high
    if not orb_bull and not orb_bear and close > orb_high
        orb_bull := true
        breakout_bar := bar_index
        state := 6
        string brkLabel = shakeout_detected ? "ORB BULL — SHAKEOUT RECOVERY" : "ORB BULL — ADD SIZE"
        color brkColor = shakeout_detected ? color.teal : color.green
        label.new(bar_index, low, brkLabel,
             style=label.style_label_up, color=brkColor, textcolor=color.white, size=size.large)
        alert(str.format("TSLA ORB BULL BREAK at {0,number,#.##} — ADD SIZE", close), alert.freq_once_per_bar)

    // Bear breakout: close below ORB low
    if not orb_bull and not orb_bear and close < orb_low
        orb_bear := true
        breakout_bar := bar_index
        state := 6
        label.new(bar_index, high, "ORB BEAR — EXIT",
             style=label.style_label_down, color=color.red, textcolor=color.white, size=size.large)
        alert(str.format("TSLA ORB BEAR BREAK at {0,number,#.##} — EXIT", close), alert.freq_once_per_bar)

// ─── STATE 6: BREAKOUT — exit timer ────────────────────────
// For bull breakout: exit 10 bars later (optimal 10m hold for options)
if state == 6 and orb_bull and not na(breakout_bar) and bar_index == breakout_bar + 10
    label.new(bar_index, high, "EXIT — TAKE PROFIT",
         style=label.style_label_down, color=color.green, textcolor=color.white, size=size.large)
    alert("TSLA EXIT — 10 bars after bull breakout — TAKE PROFIT", alert.freq_once_per_bar)
    state := 7

// Timeout: no breakout by 9:55 → done
if state == 5 and hm >= 955
    label.new(bar_index, high, "ORB — NO BREAK (timeout)",
         style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
    state := 7

// Bear breakout → immediately done (you exited)
if state == 6 and orb_bear
    state := 7

// ─── STATE 7: DONE ─────────────────────────────────────────
// Nothing — all lines/labels remain visible

// ─── Background Colors ─────────────────────────────────────
color bgColor = na
if i_showBG and isActiveWindow
    if state == 1
        bgColor := tier == "—" ? color.new(color.gray, 95) :
                   tier == "NO-GO" ? color.new(color.red, 92) :
                   color.new(color.green, 92)
    else if state == 2 or state == 3
        if fakeout_fired
            bgColor := color.new(color.red, 85)
        else
            bgColor := tier == "NO-GO" ? color.new(color.red, 92) : color.new(color.green, 92)
    else if state == 4
        bgColor := color.new(color.yellow, 93)  // ORB building
    else if state == 5
        bgColor := color.new(color.yellow, 95)  // ORB watching
    else if state == 6
        bgColor := orb_bull ? color.new(color.green, 90) : color.new(color.red, 88)

bgcolor(bgColor)

// ─── Corner Table ──────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 5,
     bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if i_showTable and isActiveWindow
    table.cell(infoTable, 0, 0, "TSLA OPEN SCALP", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "v1.1a", text_color=color.gray, text_size=size.tiny)

    string stateStr = state == 0 ? "SLEEP" : state == 1 ? "PRE-SCAN" :
                      state == 2 ? "OPENING" : state == 3 ? "FAKEOUT" :
                      state == 4 ? "ORB BUILD" : state == 5 ? "ORB WATCH" :
                      state == 6 ? (orb_bull ? "BULL BREAK" : "BEAR BREAK") : "DONE"
    color stateColor = state == 6 ? (orb_bull ? color.green : color.red) :
                       tier == "HIGH" ? color.green : tier == "MED" ? color.lime :
                       tier == "LOW" ? color.gray : tier == "NO-GO" ? color.red : color.white
    table.cell(infoTable, 0, 1, stateStr, text_color=stateColor, text_size=size.normal)
    table.cell(infoTable, 1, 1, tier != "—" ? str.format("{0} ({1}/5)", tier, confidence) : "",
               text_color=stateColor, text_size=size.small)

    string vixStr = not na(vix_prev_close) ? str.format("VIX: {0,number,#.#}", vix_prev_close) : "VIX: N/A"
    color vixColor = not na(vix_prev_close) ? (vix_prev_close <= 15 ? color.red : vix_prev_close >= 18 and vix_prev_close <= 25 ? color.green : color.gray) : color.gray
    table.cell(infoTable, 0, 2, vixStr, text_color=vixColor, text_size=size.small)

    // Row 3: PM or ORB info
    if state <= 3
        string pmStr = not na(pm_position) ? str.format("PM: pos={0,number,#.##} acc={1,number,#.#}", pm_position, nz(pm_accel)) : "PM: waiting..."
        table.cell(infoTable, 0, 3, pmStr, text_color=color.white, text_size=size.small)
    else if state >= 4 and not na(orb_high)
        table.cell(infoTable, 0, 3, str.format("ORB: {0,number,#.##} — {1,number,#.##}", orb_high, orb_low),
             text_color=color.yellow, text_size=size.small)

    // Row 4: alignment, entry, or breakout countdown
    if state <= 1
        bool tsla_up_t = not na(pm_late_trend) and pm_late_trend > 0
        bool spy_up_t  = not na(spy_929) and not na(spy_920) and spy_929 > spy_920
        bool qqq_up_t  = not na(qqq_929) and not na(qqq_920) and qqq_929 > qqq_920
        table.cell(infoTable, 0, 4, str.format("Align: T{0} S{1} Q{2}",
             tsla_up_t ? "↑" : "↓", spy_up_t ? "↑" : "↓", qqq_up_t ? "↑" : "↓"),
             text_color=color.white, text_size=size.small)
    else if state >= 2 and state <= 5 and not na(open_930)
        table.cell(infoTable, 0, 4, str.format("Entry: {0,number,#.##}  SL: {1,number,#.##}",
             open_930, open_930 - i_slDistance),
             text_color=color.white, text_size=size.small)
    else if state == 6 and orb_bull and not na(breakout_bar)
        int barsLeft = 10 - (bar_index - breakout_bar)
        table.cell(infoTable, 0, 4, str.format("EXIT in {0} bars", math.max(0, barsLeft)),
             text_color=color.green, text_size=size.small)

if not isActiveWindow or not i_showTable
    table.clear(infoTable, 0, 0, 1, 4)

// ─── Alerts ────────────────────────────────────────────────
if is0929 and state == 1
    if not hard_kill and confidence >= 3
        alert(str.format("TSLA GO: confidence {0} ({1}/5) — enter small at open", tier, confidence), alert.freq_once_per_bar)
    if hard_kill or confidence < 2
        string reason = hard_kill ? (not na(vix_prev_close) and vix_prev_close <= 15 ? "VIX <= 15" :
                       (not na(pm_position) and pm_position < 0.219 and not na(pm_accel) and pm_accel < 0 ? "P9 bear" : "gap trap")) : "low score"
        alert(str.format("TSLA NO-GO: {0} — skip today", reason), alert.freq_once_per_bar)
// ORB breakout alerts are inline above (state 5→6 transition)
