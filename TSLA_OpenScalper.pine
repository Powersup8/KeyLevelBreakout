// © TSLA Open Scalper
// 0DTE/1DTE opening trade decision system (v1.3)
// v1.3: remove fallback SL (ORB low only), hold=3 default, PM vol kill=7000, dual exit labels
// v1.2c: fix SL self-trigger on ORB freeze bar, fakeout = bar2 must break bar1 low
// v1.2: 2m accel, 15s/30s sub-bars, ORB-based SL, min ORB width
// Designed for TSLA on 1-min chart with Extended Hours ON
//@version=6
indicator("TSLA Open Scalper v1.3", overlay=true, max_labels_count=50, max_lines_count=20)

// ─── Inputs ────────────────────────────────────────────────
i_vixSymbol    = input.string("CBOE:VIX", "VIX Symbol", tooltip="VIX data provider. Try TVC:VIX if CBOE:VIX fails.", group="Data")
i_holdBars     = input.int(3, "Hold Bars (0DTE exit)", minval=1, maxval=60, tooltip="Exit N bars after bull breakout. Research: hold=3 has 93% bull win, Sharpe 2.96. For 1-2DTE consider 10-20.", group="Trade")
i_runnerBars   = input.int(20, "Runner Bars (1-2DTE)", minval=5, maxval=120, tooltip="Secondary exit label for runners. Research: hold=20 captures +$4.44 avg but 75% win.", group="Trade")
i_slFallback   = input.float(0, "Fallback SL ($)", minval=0, step=0.25, tooltip="SL before ORB freezes (9:30-9:34). Set 0 to disable. Research: removing fallback SL triples total PnL ($96 vs $32), Sharpe 2.48 vs 1.21.", group="Trade")
i_minOrbWidth  = input.float(1.0, "Min ORB Width ($)", minval=0.25, step=0.25, tooltip="Skip breakout if ORB range < this (noise filter). Research: P25=$3.70, too narrow = false breakouts.", group="Trade")
i_dipRecovery  = input.float(15.0, "Dip Entry Recovery (%)", minval=5.0, maxval=50.0, step=5.0, tooltip="On shakeout bars: enter at bar low + X% of bar range (captures turning point)", group="Trade")
i_pmVolMinKill = input.float(7000, "PM Vol Min Kill", minval=0, step=1000, tooltip="Hard kill if PM volume (9:25-9:29) < this. Set 0 to disable. TV vol ~8x lower than IB: 7000 TV ≈ 53k IB (Q1 kill).", group="Trade")
i_showTable    = input.bool(true, "Show Info Table", group="Visuals")
i_showBG       = input.bool(true, "Show Background Colors", group="Visuals")
i_debugLog     = input.bool(false, "Log Signals (Pine Logs)", group="Debug")

// ─── External Data ─────────────────────────────────────────
vix_prev_close = request.security(i_vixSymbol, "D", close[1], lookahead=barmerge.lookahead_on)
spy_close      = request.security("SPY", "1", close)
qqq_close      = request.security("QQQ", "1", close)

// 15s sub-bars for P9 hard kill (last 30s of 9:29 bar)
sub15_close    = request.security_lower_tf(syminfo.tickerid, "15S", close)

// 30s sub-bars for fakeout detection (real A6 patterns)
sub30_open     = request.security_lower_tf(syminfo.tickerid, "30S", open)
sub30_high     = request.security_lower_tf(syminfo.tickerid, "30S", high)
sub30_low      = request.security_lower_tf(syminfo.tickerid, "30S", low)
sub30_close    = request.security_lower_tf(syminfo.tickerid, "30S", close)

// ─── Debug Helpers ─────────────────────────────────────────
fmtTime(int t) =>
    int _h = hour(t, "America/New_York")
    int _m = minute(t, "America/New_York")
    str.tostring(_h) + ":" + (_m < 10 ? "0" : "") + str.tostring(_m)

logMsg(string msg) =>
    if i_debugLog and barstate.isconfirmed
        log.info("[SCALP] " + syminfo.ticker + " " + fmtTime(time) + " " + msg)

// ─── Timezone & Session Detection ──────────────────────────
TZ = "America/New_York"

int h  = hour(time, TZ)
int m  = minute(time, TZ)
int hm = h * 100 + m

isPremarket    = hm >= 400 and hm <= 929
isRTH          = hm >= 930 and hm <= 1559
newSession     = isPremarket and not isPremarket[1]
is0920         = h == 9 and m == 20
is0925         = h == 9 and m == 25
is0927         = h == 9 and m == 27
is0929         = h == 9 and m == 29
is0930         = h == 9 and m == 30
is0934         = h == 9 and m == 34
is0935         = h == 9 and m == 35
isORBBuild     = hm >= 931 and hm <= 933
isActiveWindow = hm >= 920 and hm <= 955

// ─── Extended Hours Guard ──────────────────────────────────
var bool pmSeen = false
if isPremarket
    pmSeen := true
if newSession
    pmSeen := false

// ─── State Machine ─────────────────────────────────────────
// 0=SLEEP, 1=PRE_SCAN, 2=OPENING, 3=FAKEOUT, 4=ORB_BUILD,
// 5=ORB_WATCH, 6=BREAKOUT, 7=DONE
var int    state         = 0
var int    confidence    = 0
var string tier          = "—"
var bool   hard_kill     = false
var bool   fakeout_fired = false
var bool   shakeout_detected = false

// Premarket tracking
var float pm_high       = na
var float pm_low        = na
var float pm_position   = na
var float pm_accel      = na
var float pm_late_trend = na
var float close_929     = na
var float open_929      = na    // for P9 30s proxy (9:29 bar direction)
var float open_927      = na    // for 2m accel (9:27→9:29)
var float open_925      = na    // kept for PM volume window
var float open_920_tsla = na
var float pm_vol_5m     = 0.0   // PM volume 9:25-9:29

// Cross-symbol PM
var float spy_920       = na
var float qqq_920       = na
var float spy_929       = na
var float qqq_929       = na

// Session / entry
var float prev_day_close = na
var float gap            = na
var float open_930       = na   // may be adjusted to dip buy level
var float orig_open_930  = na   // always the raw 9:30 open (for 5m rule)
var float close_935      = na
var bool  is_hold        = false

// SL tracking
var bool  sl_hit         = false
var float sl_level       = na     // v1.3: na until ORB freeze (no fallback by default), then orb_low
var bool  orb_narrow     = false  // v1.2: ORB too narrow to trade

// ORB tracking
var float orb_high       = na
var float orb_low        = na
var bool  orb_bull       = false   // bull breakout detected
var bool  orb_bear       = false   // bear breakout detected
var int   breakout_bar   = na      // bar_index of breakout
var int   bar_930_idx    = na      // bar_index at 9:30

// Visual object IDs
var line  entryLine      = na
var line  slLine         = na
var line  orbHighLine    = na
var line  orbLowLine     = na
var label slPriceLabel   = na    // v1.2c: track SL price label for updates

// ─── Daily Reset ───────────────────────────────────────────
bool newRTH = isRTH and not isRTH[1]
if newSession or (newRTH and not pmSeen)
    state             := 0
    confidence        := 0
    tier              := "—"
    hard_kill         := false
    fakeout_fired     := false
    shakeout_detected := false
    pm_high           := na
    pm_low            := na
    pm_position       := na
    pm_accel          := na
    pm_late_trend     := na
    close_929         := na
    open_929          := na
    open_927          := na
    open_925          := na
    open_920_tsla     := na
    pm_vol_5m         := 0.0
    spy_920           := na
    qqq_920           := na
    spy_929           := na
    qqq_929           := na
    gap               := na
    open_930          := na
    orig_open_930     := na
    close_935         := na
    is_hold           := false
    orb_high          := na
    orb_low           := na
    orb_bull          := false
    orb_bear          := false
    breakout_bar      := na
    bar_930_idx       := na
    entryLine         := na
    slLine            := na
    sl_hit            := false
    sl_level          := na
    orb_narrow        := false
    orbHighLine       := na
    orbLowLine        := na
    slPriceLabel      := na

// ─── Prev Day Close ───────────────────────────────────────
if isRTH
    prev_day_close := close

// ─── STATE 0→1: Premarket Tracking ────────────────────────
if isPremarket and state == 0
    state := 1

if state == 1 and isPremarket
    if na(pm_high) or high > pm_high
        pm_high := high
    if na(pm_low) or low < pm_low
        pm_low := low

    if is0920
        open_920_tsla := open
        spy_920 := spy_close
        qqq_920 := qqq_close

    // Accumulate PM volume from 9:25 onward
    if hm >= 925 and hm <= 929
        pm_vol_5m += volume

    if is0925
        open_925 := open

    if is0927
        open_927 := open

    if is0929
        close_929 := close
        open_929  := open
        float pm_range = pm_high - pm_low
        pm_position   := pm_range > 0 ? (close - pm_low) / pm_range : 0.5
        pm_accel      := not na(open_927) ? close - open_927 : na   // v1.2: 2m window (9:27→9:29)
        pm_late_trend := not na(open_920_tsla) ? close - open_920_tsla : na
        spy_929 := spy_close
        qqq_929 := qqq_close

        // ── P9 hard kill: 30s accel from 15s sub-bars ──
        // On the 9:29 bar, sub15_close has 4 elements: [9:29:00, 9:29:15, 9:29:30, 9:29:45]
        // Last 30s direction = sub[3] vs sub[1] (9:29:45 close vs 9:29:15 close)
        bool p9_30s_down = false
        if array.size(sub15_close) >= 4
            float c_2945 = array.get(sub15_close, 3)
            float c_2915 = array.get(sub15_close, 1)
            p9_30s_down := c_2945 < c_2915
        else
            // Fallback: use 1m bar direction
            p9_30s_down := close < open

        // ── Confidence scoring (5 checks) ──
        confidence := 0
        hard_kill  := false

        // Check 1: PM Position above Q1
        if not na(pm_position) and pm_position > 0.219
            confidence += 1
        // Check 2: 2m acceleration positive (v1.2: was 4m)
        if not na(pm_accel) and pm_accel > 0
            confidence += 1
        // Check 3: VIX sweet spot
        if not na(vix_prev_close) and vix_prev_close >= 18 and vix_prev_close <= 25
            confidence += 1
        // Check 4: Triple PM alignment
        bool tsla_up = not na(pm_late_trend) and pm_late_trend > 0
        bool spy_up  = not na(spy_929) and not na(spy_920) and spy_929 > spy_920
        bool qqq_up  = not na(qqq_929) and not na(qqq_920) and qqq_929 > qqq_920
        if tsla_up and spy_up and qqq_up
            confidence += 1
        // Check 5: No gap danger
        float est_gap = not na(prev_day_close) ? close - prev_day_close : 0
        bool gapDangerFlat = est_gap < -2 and not na(pm_late_trend) and math.abs(pm_late_trend) < 0.48
        if not gapDangerFlat
            confidence += 1

        // ── Hard kills ──
        // VIX too calm
        if not na(vix_prev_close) and vix_prev_close <= 15
            hard_kill := true
        // P9 bear composite: low PM position + last 30s fading (v1.2: uses 15s sub-bars)
        if not na(pm_position) and pm_position < 0.219 and p9_30s_down
            hard_kill := true
        // Gap trap
        if gapDangerFlat
            hard_kill := true
        // Low PM volume (v1.2: new hard kill)
        if pm_vol_5m < i_pmVolMinKill and pm_vol_5m > 0
            hard_kill := true

        // ── Tier mapping ──
        tier := hard_kill ? "NO-GO" : confidence >= 5 ? "HIGH" : confidence >= 3 ? "MED" : confidence >= 2 ? "LOW" : "NO-GO"

        color tierColor = tier == "HIGH" ? color.green : tier == "MED" ? color.lime : tier == "LOW" ? color.gray : color.red
        label.new(bar_index, low, str.format("{0} ({1}/5)", tier, confidence),
             style=label.style_label_up, color=tierColor, textcolor=color.white, size=size.normal)

        // Log: detailed pre-scan
        string chk1 = not na(pm_position) and pm_position > 0.219 ? "1" : "0"
        string chk2 = not na(pm_accel) and pm_accel > 0 ? "1" : "0"
        string chk3 = not na(vix_prev_close) and vix_prev_close >= 18 and vix_prev_close <= 25 ? "1" : "0"
        string chk4 = tsla_up and spy_up and qqq_up ? "1" : "0"
        string chk5 = not gapDangerFlat ? "1" : "0"
        string alignStr = str.format("T{0}S{1}Q{2}", tsla_up?"↑":"↓", spy_up?"↑":"↓", qqq_up?"↑":"↓")
        string killReason = not hard_kill ? "none" : (not na(vix_prev_close) and vix_prev_close <= 15 ? "VIX" : pm_vol_5m < i_pmVolMinKill and pm_vol_5m > 0 ? "LOW_VOL" : gapDangerFlat ? "GAP" : "P9")
        logMsg(str.format("PRE-SCAN tier={0} conf={1}/5 checks={2}{3}{4}{5}{6} kill={7}({8}) vix={9} pm_pos={10} pm_acc={11} pm_trend={12} gap={13} align={14} pm_vol={15} p9_30s={16}",
             tier, confidence, chk1, chk2, chk3, chk4, chk5,
             hard_kill ? "Y" : "N", killReason,
             str.tostring(nz(vix_prev_close), "#.#"),
             str.tostring(nz(pm_position), "#.###"),
             str.tostring(nz(pm_accel), "#.##"),
             str.tostring(nz(pm_late_trend), "#.##"),
             str.tostring(nz(est_gap), "#.##"),
             alignStr,
             str.tostring(pm_vol_5m, "#"),
             p9_30s_down ? "DN" : "UP"))

// Extended Hours warning
if is0930 and not pmSeen
    label.new(bar_index, high, "⚠ Extended Hours OFF",
         style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.normal)

// ─── STATE 2: OPENING (9:30) ──────────────────────────────
if is0930 and state == 1
    open_930      := open
    orig_open_930 := open
    bar_930_idx   := bar_index
    gap := not na(prev_day_close) ? open - prev_day_close : na
    state := 2

    // Start ORB tracking with this bar
    orb_high := high
    orb_low  := low

    logMsg(str.format("OPENING entry={0} gap={1} tier={2}",
         str.tostring(open_930, "#.##"), str.tostring(nz(gap), "#.##"), tier))

    // v1.3: fallback SL only if enabled (default=0 = disabled, ORB low is the real SL)
    if i_slFallback > 0
        sl_level := open_930 - i_slFallback

    // Draw entry line (SL line drawn after ORB freeze at 9:34 — no fallback SL line)
    if tier == "HIGH" or tier == "MED"
        entryLine := line.new(bar_index, open_930, bar_index + 25, open_930,
                     color=#00BFFF, width=3, style=line.style_solid)

// ─── STATE 3: FAKEOUT CHECK (9:30 bar close) ──────────────
if is0930 and state == 2
    state := 3

    // v1.2: Use real 30s sub-bars if available (A6 patterns from research)
    bool has30s = array.size(sub30_open) >= 2
    bool bar1_red = close < open
    float bar1_range = high - low
    bool bar1_chaotic = bar1_range > 3.04

    if has30s
        float b1_open  = array.get(sub30_open, 0)
        float b1_high  = array.get(sub30_high, 0)
        float b1_low   = array.get(sub30_low, 0)
        float b1_close = array.get(sub30_close, 0)
        float b2_open  = array.get(sub30_open, 1)
        float b2_low   = array.get(sub30_low, 1)
        float b2_close = array.get(sub30_close, 1)
        bool b1_up   = b1_close >= b1_open
        bool b1_down = b1_close < b1_open
        bool b2_down = b2_close < b2_open
        float b1_rng = b1_high - b1_low

        // v1.2c: Fakeout = UP→DOWN AND bar2 makes new low below bar1 low
        // Research: bar2 breaks bar1 low → 27% win, 64% worst (real trap)
        //           bar2 holds above → 48% win, 24% worst (normal pullback)
        if b1_up and b2_down and b2_low < b1_low
            fakeout_fired := true
        // A6: bar1 DOWN → bar2 DOWN = shakeout (78.6% win if HOLD)
        if b1_down and b2_down and not (b1_rng > 3.04)
            shakeout_detected := true
        // Chaotic: bar1 range > $3.04
        bar1_chaotic := b1_rng > 3.04
    else
        // Fallback: 1m bar analysis (same as v1.1k)
        float bar1_upper_wick = high - math.max(open, close)
        float bar1_body_size = math.abs(close - open)
        bool bar1_rejection = bar1_upper_wick > bar1_body_size and bar1_body_size > 0
        if bar1_red and bar1_rejection
            fakeout_fired := true
        if bar1_red and not bar1_rejection and not bar1_chaotic
            shakeout_detected := true

    // On shakeout: adjust entry to dip recovery level (low + X% of range)
    if shakeout_detected and (tier == "HIGH" or tier == "MED")
        float dip_entry = low + bar1_range * (i_dipRecovery / 100.0)
        float dip_sl = low - 0.50  // SL just below the turning point
        sl_level := dip_sl
        // Redraw entry line at adjusted level
        if not na(entryLine)
            line.set_y1(entryLine, dip_entry)
            line.set_y2(entryLine, dip_entry)
        open_930 := dip_entry  // update stored entry price

    // Single combined label: entry status + bar pattern (below bar)
    if tier == "HIGH" or tier == "MED"
        string entryTxt = fakeout_fired ? "ENTERED — fakeout" :
                          shakeout_detected ? str.format("DIP BUY {0,number,#.##}", open_930) :
                          bar1_chaotic ? "ENTERED — chaotic" : "ENTERED"
        color entryCol = fakeout_fired ? color.orange :
                         shakeout_detected ? color.orange :
                         bar1_chaotic ? color.orange : #00BFFF
        label.new(bar_index, low, entryTxt,
             style=label.style_label_up, color=entryCol, textcolor=color.white, size=size.normal)
    else if tier == "LOW"
        label.new(bar_index, low, "WATCHING",
             style=label.style_label_up, color=color.gray, textcolor=color.white, size=size.normal)

    // v1.2c: Fakeout = warning only (one label, not two). UP→DOWN is info, not a hard exit command.
    // On MED/HIGH days the ORB breakout is the real decision — fakeout is context.
    if fakeout_fired
        label.new(bar_index, high, "FAKEOUT — watch ORB",
             style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.normal)

    logMsg(str.format("FAKEOUT bar1_red={0} fakeout={1} shakeout={2} chaotic={3} range={4} entry={5}",
         bar1_red ? "Y" : "N", fakeout_fired ? "Y" : "N", shakeout_detected ? "Y" : "N",
         bar1_chaotic ? "Y" : "N", str.tostring(bar1_range, "#.##"), str.tostring(open_930, "#.##")))

    // Price label at entry line end (SL label created at ORB freeze)
    if (tier == "HIGH" or tier == "MED") and not na(entryLine)
        label.new(bar_index + 25, open_930, str.format("entry {0,number,#.##}", open_930),
             style=label.style_label_left, color=#00BFFF, textcolor=color.white, size=size.small)

// ─── STATE 4: ORB BUILD (9:31–9:34) ───────────────────────
// Track the 5-minute opening range high/low
if state == 3 and isORBBuild
    state := 4

if state == 4 and isORBBuild
    if high > orb_high
        orb_high := high
    if low < orb_low
        orb_low := low

// ─── STATE 5: ORB WATCH (after 9:34) ──────────────────────
// ORB complete at 9:34 close (5 bars: 9:30-9:34 = 5 minutes)
if is0934 and (state == 3 or state == 4)
    // Include 9:34 bar in ORB (last bar of the 5m range)
    if high > orb_high
        orb_high := high
    if low < orb_low
        orb_low := low

    // Freeze ORB — draw lines + shaded zone
    orbHighLine := line.new(bar_930_idx, orb_high, bar_930_idx + 25, orb_high,
                 color=color.yellow, width=2, style=line.style_dashed)
    orbLowLine  := line.new(bar_930_idx, orb_low, bar_930_idx + 25, orb_low,
                 color=color.yellow, width=2, style=line.style_dashed)
    linefill.new(orbHighLine, orbLowLine, color=color.new(color.yellow, 90))

    // v1.2c: Switch SL to ORB low — redraw line starting from this bar (not from 9:30)
    sl_level := orb_low
    if not na(slLine)
        line.delete(slLine)
    slLine := line.new(bar_index, sl_level, bar_index + 20, sl_level,
                 color=#FF4444, width=3, style=line.style_solid)
    if not na(slPriceLabel)
        label.delete(slPriceLabel)
    slPriceLabel := label.new(bar_index + 20, sl_level, str.format("SL {0,number,#.##} (ORB)", sl_level),
         style=label.style_label_left, color=#FF4444, textcolor=color.white, size=size.small)

    // v1.2: Check min ORB width
    float orb_width = orb_high - orb_low
    orb_narrow := orb_width < i_minOrbWidth

    // 5m rule: close of 9:34 bar vs original 9:30 open (5 minutes of trading)
    close_935 := close
    is_hold := not na(close_935) and not na(orig_open_930) and close_935 > orig_open_930

    // 5m info label at 9:34 bar
    string fiveMinTxt = is_hold ? "5m: above ✓" : "5m: below ✗"
    if orb_narrow
        fiveMinTxt += " | ORB narrow"
    color fiveMinCol = is_hold ? color.green : color.orange
    label.new(bar_index, high, fiveMinTxt,
         style=label.style_label_down, color=fiveMinCol, textcolor=color.white, size=size.small)

    logMsg(str.format("ORB FROZEN H={0} L={1} width={2} 5m={3} close={4} orig_open={5} sl={6} narrow={7}",
         str.tostring(orb_high, "#.##"), str.tostring(orb_low, "#.##"),
         str.tostring(orb_width, "#.##"),
         is_hold ? "HOLD" : "BAIL", str.tostring(close_935, "#.##"),
         str.tostring(orig_open_930, "#.##"),
         str.tostring(sl_level, "#.##"),
         orb_narrow ? "Y" : "N"))

    state := 5

// ─── SL Hit Detection (states 3-5) ─────────────────────────
// v1.3: sl_level is na during ORB build (no fallback), set to orb_low at 9:34
// Skip 9:34 bar — if it sets the ORB low, sl_level == bar low → false trigger
if (state >= 3 and state <= 5) and not sl_hit and not is0934 and not na(sl_level) and low <= sl_level
    sl_hit := true
    label.new(bar_index, sl_level, "SL HIT — EXIT",
         style=label.style_label_up, color=#FF4444, textcolor=color.white, size=size.large)
    alert(str.format("TSLA SL HIT at {0,number,#.##} — EXIT NOW", sl_level), alert.freq_once_per_bar)
    logMsg(str.format("SL HIT low={0} sl_level={1} entry={2} loss={3}",
         str.tostring(low, "#.##"), str.tostring(sl_level, "#.##"),
         str.tostring(open_930, "#.##"), str.tostring(sl_level - open_930, "#.##")))

// ─── Breakout detection (state 5, each bar after 9:35) ────
// v1.2: skip breakout if ORB too narrow (noise filter)
if state == 5 and hm >= 935 and hm <= 955 and not orb_narrow
    // Bull breakout: close above ORB high
    if not orb_bull and not orb_bear and close > orb_high
        orb_bull := true
        breakout_bar := bar_index
        state := 6
        string brkLabel = shakeout_detected ? "ORB BULL — SHAKEOUT RECOVERY" : "ORB BULL — ADD SIZE"
        color brkColor = shakeout_detected ? color.teal : color.green
        label.new(bar_index, low, brkLabel,
             style=label.style_label_up, color=brkColor, textcolor=color.white, size=size.large)
        alert(str.format("TSLA ORB BULL BREAK at {0,number,#.##} — ADD SIZE", close), alert.freq_once_per_bar)
        logMsg(str.format("ORB BULL BREAK close={0} > orbH={1} shakeout={2}",
             str.tostring(close, "#.##"), str.tostring(orb_high, "#.##"), shakeout_detected ? "Y" : "N"))

    // Bear breakout: close below ORB low
    if not orb_bull and not orb_bear and close < orb_low
        orb_bear := true
        breakout_bar := bar_index
        state := 6
        label.new(bar_index, high, "ORB BEAR — EXIT",
             style=label.style_label_down, color=color.red, textcolor=color.white, size=size.large)
        alert(str.format("TSLA ORB BEAR BREAK at {0,number,#.##} — EXIT", close), alert.freq_once_per_bar)
        float bear_pnl = close - open_930
        logMsg(str.format("ORB BEAR BREAK close={0} < orbL={1} entry={2} pnl={3}",
             str.tostring(close, "#.##"), str.tostring(orb_low, "#.##"),
             str.tostring(open_930, "#.##"), str.tostring(bear_pnl, "#.##")))

// ─── STATE 6: BREAKOUT — dual exit timer ─────────────────────
// v1.3: Two exit signals — quick take-profit (0DTE) + runner exit (1-2DTE)
// Primary: hold=3 bars (93% bull win, Sharpe 2.96)
// Secondary: hold=20 bars (75% bull win, $4.44 avg — for identified runners)
if state == 6 and orb_bull and not na(breakout_bar)
    int bars_since = bar_index - breakout_bar

    // Primary exit: quick take-profit
    if bars_since == i_holdBars
        float pnl_quick = close - open_930
        label.new(bar_index, high, str.format("EXIT {0}b — ${1,number,#.##}", i_holdBars, pnl_quick),
             style=label.style_label_down, color=color.green, textcolor=color.white, size=size.large)
        alert(str.format("TSLA EXIT — {0} bars after bull breakout — TAKE PROFIT ${1,number,#.##}", i_holdBars, pnl_quick), alert.freq_once_per_bar)
        logMsg(str.format("EXIT TAKE_PROFIT close={0} entry={1} pnl={2} bars_held={3}",
             str.tostring(close, "#.##"), str.tostring(open_930, "#.##"),
             str.tostring(pnl_quick, "#.##"), bars_since))

    // Secondary exit: runner target (only if different from primary)
    if bars_since == i_runnerBars and i_runnerBars != i_holdBars
        float pnl_runner = close - open_930
        label.new(bar_index, high, str.format("RUNNER {0}b — ${1,number,#.##}", i_runnerBars, pnl_runner),
             style=label.style_label_down, color=color.teal, textcolor=color.white, size=size.normal)
        alert(str.format("TSLA RUNNER EXIT — {0} bars — ${1,number,#.##}", i_runnerBars, pnl_runner), alert.freq_once_per_bar)
        logMsg(str.format("EXIT RUNNER close={0} entry={1} pnl={2} bars_held={3}",
             str.tostring(close, "#.##"), str.tostring(open_930, "#.##"),
             str.tostring(pnl_runner, "#.##"), bars_since))
        state := 7

    // Done after runner exit (or after primary if no runner configured)
    if bars_since == math.max(i_holdBars, i_runnerBars)
        state := 7

// Timeout: no breakout by 9:55 → done
if state == 5 and hm >= 955
    label.new(bar_index, high, "ORB — NO BREAK (timeout)",
         style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
    float pnl_timeout = not na(open_930) ? close - open_930 : na
    logMsg(str.format("ORB TIMEOUT no_break close={0} entry={1} pnl={2} orbH={3} orbL={4}",
         str.tostring(close, "#.##"), str.tostring(nz(open_930), "#.##"),
         str.tostring(nz(pnl_timeout), "#.##"),
         str.tostring(nz(orb_high), "#.##"), str.tostring(nz(orb_low), "#.##")))
    state := 7

// Bear breakout → immediately done (you exited)
if state == 6 and orb_bear
    state := 7

// ─── STATE 7: DONE ─────────────────────────────────────────
// Nothing — all lines/labels remain visible

// ─── Background Colors ─────────────────────────────────────
color bgColor = na
if i_showBG and isActiveWindow
    if state == 1
        bgColor := tier == "—" ? color.new(color.gray, 95) :
                   tier == "NO-GO" ? color.new(color.red, 92) :
                   color.new(color.green, 92)
    else if state == 2 or state == 3
        if fakeout_fired
            bgColor := color.new(color.red, 85)
        else
            bgColor := tier == "NO-GO" ? color.new(color.red, 92) : color.new(color.green, 92)
    else if state == 4
        bgColor := color.new(color.yellow, 93)  // ORB building
    else if state == 5
        bgColor := color.new(color.yellow, 95)  // ORB watching
    else if state == 6
        bgColor := orb_bull ? color.new(color.green, 90) : color.new(color.red, 88)

bgcolor(bgColor)

// ─── Corner Table ──────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 5,
     bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if i_showTable and isRTH
    table.cell(infoTable, 0, 0, "TSLA OPEN SCALP", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "v1.3", text_color=color.gray, text_size=size.tiny)

    string stateStr = state == 0 ? "SLEEP" : state == 1 ? "PRE-SCAN" :
                      state == 2 ? "OPENING" : state == 3 ? "FAKEOUT" :
                      state == 4 ? "ORB BUILD" : state == 5 ? "ORB WATCH" :
                      state == 6 ? (orb_bull ? "BULL BREAK" : "BEAR BREAK") : "DONE"
    color stateColor = state == 6 ? (orb_bull ? color.green : color.red) :
                       tier == "HIGH" ? color.green : tier == "MED" ? color.lime :
                       tier == "LOW" ? color.gray : tier == "NO-GO" ? color.red : color.white
    table.cell(infoTable, 0, 1, stateStr, text_color=stateColor, text_size=size.normal)
    table.cell(infoTable, 1, 1, tier != "—" ? str.format("{0} ({1}/5)", tier, confidence) : "",
               text_color=stateColor, text_size=size.small)

    string vixStr = not na(vix_prev_close) ? str.format("VIX: {0,number,#.#}", vix_prev_close) : "VIX: N/A"
    color vixColor = not na(vix_prev_close) ? (vix_prev_close <= 15 ? color.red : vix_prev_close >= 18 and vix_prev_close <= 25 ? color.green : color.gray) : color.gray
    table.cell(infoTable, 0, 2, vixStr, text_color=vixColor, text_size=size.small)

    // Row 3: PM or ORB info
    if state <= 3
        string pmStr = not na(pm_position) ? str.format("PM: pos={0,number,#.##} acc={1,number,#.#}", pm_position, nz(pm_accel)) : "PM: waiting..."
        table.cell(infoTable, 0, 3, pmStr, text_color=color.white, text_size=size.small)
    else if state >= 4 and not na(orb_high)
        table.cell(infoTable, 0, 3, str.format("ORB: {0,number,#.##} — {1,number,#.##}", orb_high, orb_low),
             text_color=color.yellow, text_size=size.small)

    // Row 4: alignment, entry, or breakout countdown
    if state <= 1
        bool tsla_up_t = not na(pm_late_trend) and pm_late_trend > 0
        bool spy_up_t  = not na(spy_929) and not na(spy_920) and spy_929 > spy_920
        bool qqq_up_t  = not na(qqq_929) and not na(qqq_920) and qqq_929 > qqq_920
        table.cell(infoTable, 0, 4, str.format("Align: T{0} S{1} Q{2}",
             tsla_up_t ? "↑" : "↓", spy_up_t ? "↑" : "↓", qqq_up_t ? "↑" : "↓"),
             text_color=color.white, text_size=size.small)
    else if state >= 2 and state <= 5 and not na(open_930)
        string slSource = state >= 5 ? " (ORB)" : (i_slFallback > 0 ? " (fallback)" : " (none)")
        string slStr = not na(sl_level) ? str.format("  SL: {0,number,#.##}{1}", sl_level, slSource) : "  SL: after ORB"
        table.cell(infoTable, 0, 4, str.format("Entry: {0,number,#.##}{1}", open_930, slStr),
             text_color=color.white, text_size=size.small)
    else if state == 6 and orb_bull and not na(breakout_bar)
        int barsLeft = i_holdBars - (bar_index - breakout_bar)
        string exitStr = barsLeft > 0 ? str.format("EXIT in {0} bars", barsLeft) : "EXIT NOW"
        table.cell(infoTable, 0, 4, exitStr,
             text_color=color.green, text_size=size.small)

if not isRTH and not isPremarket
    table.clear(infoTable, 0, 0, 1, 4)

// ─── Alerts ────────────────────────────────────────────────
if is0929 and state == 1
    if not hard_kill and confidence >= 3
        alert(str.format("TSLA GO: confidence {0} ({1}/5) — enter small at open", tier, confidence), alert.freq_once_per_bar)
    if hard_kill or confidence < 2
        string reason = hard_kill ? (not na(vix_prev_close) and vix_prev_close <= 15 ? "VIX <= 15" :
                       (pm_vol_5m < i_pmVolMinKill and pm_vol_5m > 0 ? "low PM vol" :
                       (not na(pm_position) and pm_position < 0.219 ? "P9 bear" : "gap trap"))) : "low score"
        alert(str.format("TSLA NO-GO: {0} — skip today", reason), alert.freq_once_per_bar)
// ORB breakout alerts are inline above (state 5→6 transition)
